{
  "name": "gw2-world-events-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker + Durable Object relay for gw2-world-events live event reports",
  "scripts": {
    "sync-maps": "python3 scripts/sync_live_event_maps.py",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "npm run sync-maps && tsc --noEmit",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  }
}